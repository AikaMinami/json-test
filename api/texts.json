        {
            "id": "scenario2_2.introduction.title_01",
            "text_list": [
                {
                    "lang": "en",
                    "text_displayed": "Introduction"
                },
                {
                    "lang": "id",
                    "text_displayed": "Pengenalan"
                }
            ]
        },
        {
            "id": "scenario2_2.introduction.desc_01",
            "text_list": [
                {
                    "lang": "en",
                    "text_displayed": "As a campus security officer, you are responsible for protecting students and staff, maintaining order, and identifying potential risks throughout the campus"
                },
                {
                    "lang": "id",
                    "text_displayed": "Sebagai petugas keamanan kampus, Anda bertanggung jawab untuk melindungi mahasiswa dan staf, menjaga ketertiban, serta mengidentifikasi potensi risiko di seluruh area kampus."
                }
            ]
        },
        {
            "id": "scenario2_2.introduction.greeting",
            "text_list": [
                {
                    "lang": "en",
                    "text_displayed": "Welcome, {name}!"
                },
                {
                    "lang": "id",
                    "text_displayed": "Selamat datang, {name}!"
                }
            ]
        },
        {
            "id": "scenario2_2.introduction.desc_02",
            "text_list": [
                {
                    "lang": "en",
                    "text_displayed": "You are a campus security officer stationed at an integrated university campus and assigned to patrol the campus and its outer perimeter to identify security anomalies and conduct security risk assessments."
                },
                {
                    "lang": "id",
                    "text_displayed": "Anda adalah petugas keamanan kampus yang ditempatkan di kampus universitas terpadu dan ditugaskan untuk berpatroli di area kampus serta perimeter luarnya guna mengidentifikasi anomali keamanan dan melakukan penilaian risiko keamanan."
                }
            ]
        },
        {
            "id": "scenario2_2.timer.title_01",
            "text_list": [
                {
                    "lang": "en",
                    "text_displayed": "Now Loading"
                },
