        {
            "id": "scenario2_2.awareness_test.desc_01",
            "text_list": [
                {
                    "lang": "en",
                    "text_displayed": "You will be shown a picture of <color=#00E1FF>15 items</color> on the floor of the security officer’s locker room. Observe carefully. You have <color=#00E1FF>1 minute</color> to memorise them before they disappear."
                },
                {
                    "lang": "id",
                    "text_displayed": "Anda akan diperlihatkan gambar berisi <color=#00E1FF>15 benda</color> di lantai ruang loker petugas keamanan. Perhatikanlah dengan saksama. Anda memiliki waktu <color=#00E1FF>1 menit</color> untuk menghafalnya sebelum benda-benda tersebut menghilang."
                }
            ]
        },
